{
  "name": "reobote-aplicativo-android",
  "version": "1.0.0",
  "private": true,
  "description": "Empacota o aplicativo REOBOTE (pasta ../app) como APK Android usando o Capacitor.",
  "scripts": {
    "preparar": "node scripts/preparar-www.mjs",
    "android:criar": "npx cap add android",
    "android:configurar": "node scripts/configurar-android.mjs",
    "android:sincronizar": "npx cap sync android",
    "android:abrir": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.2.26",
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0"
  }
}
