# REOBOTE | .gitattributes — Padroniza o fim de linha e marca imagens e fontes como binárias
# Padroniza o fim de linha (LF) e marca imagens/fontes como binários.
* text=auto eol=lf
*.png binary
*.jpg binary
*.woff2 binary
*.ttf binary
*.apk binary
# Scripts do Windows precisam do fim de linha do Windows (CRLF).
*.bat text eol=crlf
*.ps1 text eol=crlf
