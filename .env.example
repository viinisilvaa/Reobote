# REOBOTE | .env.example — Modelo de configuração do servidor (banco de dados e chave de sessão)
# Copie este arquivo para server/.env e preencha os valores.
APP_ENV=development
# Segredo aleatório com pelo menos 32 caracteres (ex.: php -r "echo bin2hex(random_bytes(32));").
SESSION_SECRET=replace-with-at-least-32-random-characters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=reobote
MYSQL_USER=reobote_app
MYSQL_PASSWORD=
